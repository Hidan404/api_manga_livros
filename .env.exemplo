# ============================================================
# API Manga Livros — Exemplo de variáveis de ambiente
#
# COMO USAR:
#   1. Copie este arquivo para `.env`
#      (cp .env.exemplo .env)
#   2. Preencha com valores reais
#   3. O `.env` está no .gitignore e NUNCA deve ir para o repo
#
# GERE CHAVES SEGURAS COM:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ---------------- Ambiente ----------------
# `development` (local) ou `production` (Render/Supabase)
ENVIRONMENT=development

# ---------------- JWT ----------------
# Chave que assina os ACCESS tokens
SECRET_KEY=your_super_secret_key_here
# Chave que assina os REFRESH tokens — DEVE ser diferente da SECRET_KEY
REFRESH_SECRET_KEY=your_refresh_secret_key_here
# Algoritmo de assinatura dos tokens JWT
ALGORITHM=HS256
# Validade do access token em minutos (curto: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Validade do refresh token em dias (longo: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30
# Validade do refresh token em minutos (fallback p/ fluxos que pedem minutos)
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ---------------- Cookies (entrega de token ao frontend — Sprint 2) ----------------
# true em produção (HTTPS obrigatório), false em desenvolvimento local
COOKIE_SECURE=false
# Política SameSite: lax (recomendado) | strict | none
COOKIE_SAMESITE=lax
# Domínio do cookie. Deixe vazio para usar o host da requisição.
# Ex.: .seudominio.com
COOKIE_DOMAIN=

# ---------------- PostgreSQL ----------------
# Estas 3 vars são usadas pelo docker-compose (criação do container db).
# O app em si só usa DATABASE_URL.
POSTGRES_DB=mangas_livros
POSTGRES_USER=usuario
POSTGRES_PASSWORD=sua_senha_aqui

# ---------------- Usuário admin (seed) ----------------
# Usados pelo script seed_admin.py (cria/promove o administrador)
# ADMIN_SENHA pode ser uma senha em texto OU um hash bcrypt ($2b$...).
# Recomendado: use um hash bcrypt real para não manter a senha em texto puro.
# Gere com:  python -c "from app.utils.senha_hasher import SenhaHasher; print(SenhaHasher.hash_criar('sua_senha_forte'))"
ADMIN_EMAIL=admin@email.com
ADMIN_SENHA=sua_senha_forte_aqui

# ---------------- Cloudinary (upload de capas — Sprint 5) ----------------
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://seu_api_key:seu_api_secret@sua_cloud_name

# ---------------- Database Connection URL ----------------
# AMBIENTE LOCAL (Postgres do docker-compose — mapeado para a porta 5434):
DATABASE_URL=postgresql+psycopg://usuario:sua_senha_aqui@localhost:5434/mangas_livros
#
# PRODUÇÃO (Supabase — exige SSL, usar pooler ou conexão direta):
# DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require

# ---------------- Banco de dados: modo SSL ----------------
# require  -> produção (Supabase, Render)
# disable  -> local (Postgres sem SSL)
# Este valor é usado por app/database/conexao.py (Sprint 1)
SSL_MODE=disable
