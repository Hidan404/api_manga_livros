# ===============================
# JWT Configuration
# ===============================

# Chave secreta para gerar tokens JWT
SECRET_KEY=your_super_secret_key_here

# Chave usada para refresh tokens
REFRESH_SECRET_KEY=your_refresh_secret_key_here

# Algoritmo de assinatura
ALGORITHM=HS256

# Tempo de expiração do access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tempo de expiração do refresh token (dias)
REFRESH_TOKEN_EXPIRE_DAYS=30


# ===============================
# PostgreSQL Database
# ===============================

POSTGRES_DB=mangas_livros
POSTGRES_USER=usuario
POSTGRES_PASSWORD=sua_senha_aqui


# ===============================
# Database Connection URL
# ===============================

DATABASE_URL=postgresql+psycopg://usuario:sua_senha_aqui@localhost:5432/mangas_livros