########################################
### REGISTRAR USUÁRIO ADMIN
POST http://127.0.0.1:8000/auth/register
Content-Type: application/json

{
  "nome": "Admin10",
  "email": "admin10@email.com",
  "senha": "123456",
  "role": "admin"
}

###

########################################
### LOGIN (PEGAR TOKEN)
POST http://127.0.0.1:8000/auth/login
Content-Type: application/json

{
  "email": "admin10@email.com",
  "senha": "123456"
}

###

########################################
### 👇 COLE O TOKEN DO LOGIN AQUI
@token = @token = <COLE_AQUI_O_TOKEN_DO_LOGIN>



########################################
### CRUD MANGÁS

### LISTAR MANGÁS (público)
GET http://127.0.0.1:8000/mangas/

###

### TESTE ADMIN (somente admin)
POST http://127.0.0.1:8000/mangas/teste-admin
Authorization: Bearer {{token}}

###

### CRIAR MANGÁ (admin)
POST http://127.0.0.1:8000/mangas/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Bleach",
  "autor": "Tite Kubo",
  "genero": "Shonen",
  "volumes": 74,
  "status": "Concluído",
  "descricao": "Mangá sobre shinigamis e hollows."
}

###

### ATUALIZAR MANGÁ (admin)
PUT http://127.0.0.1:8000/mangas/7
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "descricao": "Atualizado via testes"
}

###

### DELETAR MANGÁ (admin)
DELETE http://127.0.0.1:8000/mangas/6
Authorization: Bearer {{token}}

###

########################################
### CRUD LIVROS

### LISTAR LIVROS
GET http://127.0.0.1:8000/livros/

###

### CRIAR LIVRO (admin)
POST http://127.0.0.1:8000/livros/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "hellraiser",
  "autor": "Clive Barker",
  "descricao": "Livro de terror sobre os cenobitas.",
  "ano": 1986,
  "genero": "Terror"
}

###

########################################
### FAVORITOS - MANGÁS

### ADICIONAR MANGÁ AOS FAVORITOS
POST http://127.0.0.1:8000/favoritos/manga/7
Authorization: Bearer {{token}}

###

### LISTAR FAVORITOS DE MANGÁS
GET http://127.0.0.1:8000/favoritos/manga/
Authorization: Bearer {{token}}

###

### REMOVER MANGÁ DOS FAVORITOS
DELETE http://127.0.0.1:8000/favoritos/manga/3
Authorization: Bearer {{token}}

###

########################################
### FAVORITOS - LIVROS

### ADICIONAR LIVRO NOS FAVORITOS
POST http://127.0.0.1:8000/favoritos/livro/1
Authorization: Bearer {{token}}

###

### LISTAR FAVORITOS DE LIVROS
GET http://127.0.0.1:8000/favoritos/livro/
Authorization: Bearer {{token}}

###

### REMOVER LIVRO DOS FAVORITOS
DELETE http://127.0.0.1:8000/favoritos/livro/1
Authorization: Bearer {{token}}
###
