# ===============================
# Security / JWT
# ===============================

# Chave secreta usada para gerar os tokens JWT
SECRET_KEY=your_secret_key_here

# Chave usada para refresh tokens
REFRESH_SECRET_KEY=your_refresh_secret_key_here

# Algoritmo de assinatura do JWT
ALGORITHM=HS256

# Tempo de expiração do access token (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tempo de expiração do refresh token (em dias)
REFRESH_TOKEN_EXPIRE_DAYS=30


# ===============================
# Database
# ===============================

# URL de conexão com o PostgreSQL
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/mangas_livros